# Firebase Client SDK
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase Admin SDK (Optional)
# FIREBASE_PROJECT_ID=
# GOOGLE_APPLICATION_CREDENTIALS=
# FIREBASE_SERVICE_ACCOUNT_JSON=

# Pinecone
PINECONE_API_KEY=
PINECONE_INDEX_HOST=
PINECONE_NAMESPACE=

# Gemini
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-2.5-flash

# LinkedIn-Integration (optional)
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:9002/api/linkedin/callback
# Dedizierter Schluessel fuer die Token-Verschluesselung in Firestore
# (optional; Fallback: abgeleitet aus LINKEDIN_CLIENT_SECRET)
# LINKEDIN_TOKEN_KEY=
# Branding in generierten Posts/Bildern (leer = neutral, keine Erwaehnung)
# LINKEDIN_BRAND_NAME=
# Personen-Beschreibung fuer generierte Bilder, falls kein
# public/linkedin/person-reference.jpg existiert (leer = neutraler Stil ohne Person)
# LINKEDIN_IMAGE_PERSON=

# Bild-Generierung fuer LinkedIn-Posts (optional)
NANOBANANA_MODEL=
