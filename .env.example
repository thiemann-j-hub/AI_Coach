# Beispiel-Umgebung für den Coach. Kopieren nach .env.local und füllen. Hier stehen NIE echte Werte.
# Alle Schalter mit Zweck, Standard, Stand im Betrieb und Rückweg: docs/SCHALTER.md
# Auskommentierte Zeilen zeigen den Standard im Code; ohne die Variable gilt genau dieser Wert.

# ── Auth: NextAuth v5 + Microsoft Entra ID ──
# AUTH_URL = exakte Origin INKL. basePath.
#   Direkt-Modus:            http://localhost:9002  bzw.  https://<app>.azurewebsites.net
#   Hub-Front-Door (Cutover): http://localhost:8080/coach  bzw.  https://pulsenorth.ai/coach
AUTH_URL=http://localhost:9002
# openssl rand -base64 32 — im Hub-Front-Door-Modus MUSS dieser Wert IDENTISCH zum
# Hub sein (gemeinsames geteiltes Session-Cookie pulsenorth.session-token = SSO).
AUTH_SECRET=
# basePath des Front Door. Leer = Direkt-Modus; "/coach" = hinter dem Hub.
# Default ist "/coach" (next.config) — fuer Direkt-Deploy explizit "" setzen.
NEXT_PUBLIC_BASE_PATH=/coach
AUTH_MICROSOFT_ENTRA_ID_ID=
AUTH_MICROSOFT_ENTRA_ID_SECRET=
# "common" = Organisations- + persoenliche Microsoft-Konten
AUTH_MICROSOFT_ENTRA_ID_TENANT_ID=common

# ── Daten: Azure Cosmos DB (SQL/NoSQL API) ──
COSMOS_ENDPOINT=
COSMOS_KEY=
COSMOS_DATABASE=coach

# COSMOS_VECTOR_DATABASE=coach-vec
# COSMOS_VECTOR_CONTAINER=cards
# RADAR_DATABASE=pulsecraft

# ── KI: Textmodelle ──
# Entwickler-Schnittstelle (ohne Standortzusage): nur GEMINI_API_KEY.
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-2.5-flash
# GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# Dienstkonto in der EU: GEMINI_BACKEND=vertex, dazu VERTEX_PROJECT und GOOGLE_SA_KEY_JSON (Schlüssel-JSON in einer Zeile).
# GEMINI_BACKEND=vertex
# VERTEX_PROJECT=
# GOOGLE_SA_KEY_JSON=
# VERTEX_LOCATION=eu
# VERTEX_EMBED_LOCATION=europe-west3

# ── Sprache: Diktat und Vorlesen (Azure Speech) ──
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

# ── Guthaben und Zugänge (zentraler Credit-Dienst) ──
# Lokal aus: kein Guthaben-Tor, nur das Tagesbudget schützt. Im Betrieb "on".
CREDITS_CENTRAL=off
# CREDIT_SERVICE_URL=
# CREDIT_SERVICE_SCOPE=
# CREDIT_SERVICE_TIMEOUT_MS=5000
# CREDIT_TOPUP_URL=https://pulsenorth.ai/preise
# Dienst-Ausweis für PulseNorth-Konten und Aufrufe vom Hub (ohne Geheimnis sind beide aus).
# PN_SERVICE_SECRET=
# PN_SERVICE_AUTH=on
# Token-Speicher für den Credit-Dienst (Standard: die Werte der Anmeldung oben).
# ENTRA_CLIENT_ID=
# ENTRA_CLIENT_SECRET=
# ENTRA_ISSUER=
# Adressen ohne Tagesbudget und ohne Tagesgrenze der Starts (mit Komma getrennt).
# ADMIN_EMAILS=
# QUALITY_STATS_TOKEN=

# ── Rechnungs-PDFs: Azure Blob (Managed Identity, kein Account-Key) ──
AZURE_STORAGE_ACCOUNT=
INVOICE_BLOB_CONTAINER=invoices

# ── Funktionen an- und abstellen ──
# Rollenspiel. Standard im Code ist off; lokal und im Betrieb "on".
SIMULATION_ENABLED=on
# COACH_RICHTER=gemini            # opus = starkes Modell als Richter (im Betrieb)
# COACH_SPIELBUCH=on
# COACH_ENDE=on
# COACH_ENDE_PRUEFUNG=on
# COACH_REGIE=on
# COACH_VORBEREITEN=on
# COACH_INTERVIEW=                # leer = nur der Arbeitsbereich des Owners | off | all | Kennungen mit Komma
# COACH_PREFLIGHT=on
# KI_GATE=on
# CONSENT_GATE=on
# RADAR_EMIT=off                  # im Betrieb on
# SIMULATION_RADAR_EMIT=off       # im Betrieb on
# SCORING_CONSENSUS=off           # im Betrieb on
# QUALITY_CHECKS_MODE=warn        # off | warn | enforce (im Betrieb enforce)
# DIAGNOSE_REPORT=on

# ── Kosten begrenzen und Fristen ──
# COST_CAP_MODE=enforce           # off = nur zählen
# DAILY_TOKEN_LIMIT=500000
# COACH_SIM_STARTS_PER_DAY=6      # 0 = keine Tagesgrenze
# LLM_TIMEOUT_MS=45000
# BUILDER_LLM_TIMEOUT_MS=170000
# INTERVIEW_LLM_TIMEOUT_MS=25000
# COACH_RICHTER_TIMEOUT_MS=110000
# RAG_TIMEOUT_MS=6000
# TRANSFER_CHECK_MIN_HOURS=72

# ── Rückwege abgeschlossener Umbauten (nur setzen, um den alten Weg zurückzuholen) ──
# AI_ERROR_CONTRACT=off
# REQUEST_ID_IN_UI=off
# VERSION_BANNER=off
# TOAST_RULES=off
# ADDRESS_PARAM=off
# COACH_FAEHIGKEITEN=off
# COACH_NO_ACCESS_PAGE=off
# REQUIRE_VALID_LOGIN=off
# THEME_PLATTFORM=off
# DESIGN_KLAR=off

# Sprachmodus „Live“ (Owner-GO 28.10.2026, Register N4-231): Persona hört und spricht selbst über
# Gemini Live auf Vertex AI (EU-Mehrfachregion). Braucht GOOGLE_SA_KEY_JSON + VERTEX_PROJECT.
# COACH_LIVE = off (Standard) | all | <Szenario-IDs, kommagetrennt>; Rückweg: weglassen.
# App Service braucht dafür „Web Sockets“ an; Startbefehl bleibt `node server.js` (Mantel server/live-server.js).
# COACH_LIVE=sim-coaching-morgan
# COACH_LIVE_LOCATION=eu
# COACH_LIVE_MODEL=gemini-3.8-live
# COACH_LIVE_SPRECHPAUSE=normal   # kurz = das Modell nimmt das Satzende früher an
# Starkes Modell (Spielbuch, Richter opus, Interview-Bericht), ebenfalls über VERTEX_PROJECT und GOOGLE_SA_KEY_JSON.
# COACH_SPIELBUCH_MODEL=claude-opus-5-5
# COACH_SPIELBUCH_REGION=eu
