# ── Auth: NextAuth v5 + Microsoft Entra ID ──
# AUTH_URL = exakte Origin INKL. basePath.
#   Direkt-Modus:            http://localhost:9002  bzw.  https://<app>.azurewebsites.net
#   Hub-Front-Door (Cutover): http://localhost:8080/coach  bzw.  https://pulsenorth.ai/coach
AUTH_URL=http://localhost:9002
AUTH_TRUST_HOST=true
# openssl rand -base64 32 — im Hub-Front-Door-Modus MUSS dieser Wert IDENTISCH zum
# Hub sein (gemeinsames geteiltes Session-Cookie pulsenorth.session-token = SSO).
AUTH_SECRET=
# basePath des Front Door. Leer = Direkt-Modus; "/coach" = hinter dem Hub.
# Default ist "/coach" (next.config) — fuer Direkt-Deploy explizit "" setzen.
NEXT_PUBLIC_BASE_PATH=/coach
AUTH_MICROSOFT_ENTRA_ID_ID=
AUTH_MICROSOFT_ENTRA_ID_SECRET=
# "common" = Organisations- + persoenliche Microsoft-Konten
AUTH_MICROSOFT_ENTRA_ID_TENANT_ID=common

# ── Daten: Azure Cosmos DB (SQL/NoSQL API) ──
COSMOS_ENDPOINT=
COSMOS_KEY=
COSMOS_DATABASE=coach

# ── Gemini (LLM) ──
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-2.5-flash


# ── LinkedIn-Integration (optional) ──
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:9002/api/linkedin/callback
# Dedizierter Schluessel fuer die Token-Verschluesselung in Cosmos
# (optional; Fallback: abgeleitet aus LINKEDIN_CLIENT_SECRET)
# LINKEDIN_TOKEN_KEY=
# Branding in generierten Posts/Bildern (leer = neutral, keine Erwaehnung)
# LINKEDIN_BRAND_NAME=
# Personen-Beschreibung fuer generierte Bilder, falls kein
# public/linkedin/person-reference.jpg existiert (leer = neutraler Stil ohne Person)
# LINKEDIN_IMAGE_PERSON=

# Bild-Generierung fuer LinkedIn-Posts (optional)
NANOBANANA_MODEL=

# ── Bezahlsystem (Credits/Workspaces) — Feature-Flag, Default OFF ──
# "on" aktiviert den Credit-Gate in /api/analyze + Checkout/Webhook. Solange
# "off": Live-App unveraendert (nur cost-cap schuetzt).
PAYMENTS_ENABLED=off
# Basis-URL fuer Stripe success/cancel-Redirects (Fallback: AUTH_URL/Origin)
# APP_BASE_URL=https://<app>.azurewebsites.net

# ── Stripe ──
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Price-IDs der Pakete; credits_awarded als Price-Metadata in Stripe pflegen
STRIPE_PRICE_SINGLE=
STRIPE_PRICE_PACK_5=

# ── Steuer / Rechnung (native §14 UStG) ──
SUPPLIER_COUNTRY=DE
# STD_VAT_RATE=0.19
# Freemail-Domains -> Free-Run pro uid statt pro Domain (Default-Liste in code)
# FREEMAIL_DOMAINS=gmail.com,gmx.de,web.de,outlook.com,...
# Aussteller-Angaben fuer die Rechnung (Pflichtangaben §14)
INVOICE_SUPPLIER_NAME=
INVOICE_SUPPLIER_ADDRESS=
INVOICE_SUPPLIER_ZIP=
INVOICE_SUPPLIER_CITY=
INVOICE_SUPPLIER_COUNTRY=DE
INVOICE_SUPPLIER_VATID=
INVOICE_SUPPLIER_TAXNUMBER=
INVOICE_SUPPLIER_EMAIL=
INVOICE_SUPPLIER_IBAN=

# ── Invoice-PDF-Speicher: Azure Blob (Managed Identity, kein Account-Key) ──
AZURE_STORAGE_ACCOUNT=
INVOICE_BLOB_CONTAINER=invoices
